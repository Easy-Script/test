-- ========================================================
local function unequipRod()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid:UnequipTools()
    end
end

local function getOrBuyRod()
    local char = LocalPlayer.Character
    if not char then return nil end

    local inChar = char:FindFirstChild("FishingRod")
    if inChar then return inChar end

    local inBackpack = LocalPlayer.Backpack:FindFirstChild("FishingRod")
    if inBackpack and char:FindFirstChild("Humanoid") then
        char.Humanoid:EquipTool(inBackpack)
        task.wait(0.3)
        return char:FindFirstChild("FishingRod")
    end

    -- Automatically rebuy if missing
    StatusLabel.Text = "Status: Re-buying rod ($80)..."
    BuyFishingRod:FireServer("FishingRod", 80)
    task.wait(0.8)

    inBackpack = LocalPlayer.Backpack:FindFirstChild("FishingRod")
    if inBackpack and char:FindFirstChild("Humanoid") then
        char.Humanoid:EquipTool(inBackpack)
        task.wait(0.3)
        return char:FindFirstChild("FishingRod")
    end

    return nil
end

