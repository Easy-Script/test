-- ========================================================
-- 7. Real-Time Adonis Broadcast & Staff Scanner
-- ========================================================
local lastNoticeCount = 0

task.spawn(function()
    -- Initialize notice count
    if AdonisClient and AdonisClient.Variables and AdonisClient.Variables.CommunicationsHistory then
        lastNoticeCount = #AdonisClient.Variables.CommunicationsHistory
    end

    while true do
        local detected = false
        local reason = ""

        -- A. Check Adonis Communication Log (Direct :n / :m / :h sniffer)
        if AdonisClient and AdonisClient.Variables and AdonisClient.Variables.CommunicationsHistory then
            local history = AdonisClient.Variables.CommunicationsHistory
            if #history > lastNoticeCount then
                local latest = history[#history]
                lastNoticeCount = #history
                local title = latest.Title or "STAFF"
                if StaffRanks[title:upper()] or latest.Message then
                    detected = true
                    reason = "[" .. title .. " Broadcast]: " .. (latest.Message or "")
                    lastModNotice = reason
                end
            end
        end

        -- B. Check Active Adonis GUIs (Notify, Message, PM, View, Warn)
        if AdonisClient and AdonisClient.GUIs then
            for guid, gTable in pairs(AdonisClient.GUIs) do
                if type(gTable) == "table" and gTable.Destroyed ~= "true" then
                    local n = gTable.Name or ""
                    if n == "Notify" or n == "Message" or n == "Hint" or n == "PM" or n == "View" or n == "Explorer" then
                        detected = true
                        reason = "Adonis " .. n .. " active"
                        break
                    end
                end
            end
        end

        -- C. Check Server Player List (Creator / Hardcoded Staff)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if player.UserId == CreatorId or StaffList[player.Name] or StaffList[player.DisplayName] then
                    detected = true
                    reason = "Staff in Server (" .. player.Name .. ")"
                    break
                end
            end
        end

        -- Action Trigger
        if detected then
            if not modDetected then
                modDetected = true
                unequipRod()
                ModAlert.Text = "⚠️ MOD DETECTED!"
                ModAlert.TextColor3 = Color3.fromRGB(255, 60, 60)
                StatusLabel.Text = "PAUSED: " .. reason
                warn("[Anti-Mod Triggered]:", reason)
            end
        else
            -- Auto-resume if no mod broadcasts occurred for 30 seconds
            if modDetected and not lastModNotice:find("Broadcast") then
                modDetected = false
                ModAlert.Text = "🛡️ Anti-Mod: Active (Safe)"
                ModAlert.TextColor3 = Color3.fromRGB(90, 220, 120)
                StatusLabel.Text = autoFishing and "Status: Resuming..." or "Status: Idle"
            end
        end

        task.wait(1.5)
    end
end)

